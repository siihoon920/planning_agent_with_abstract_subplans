;; ASCII ;;
; W: wall, D: door, k: key, g: gem, G: goal-gem, s: start, .: empty
; agent at (4,8), keys: key1=(3,6),key2=(8,1),key3=(8,2)
; gems: gem1=(1,1),gem2=(3,1),gem3=(8,8)
; doors: door1=(1,3),door2=(2,6),door3=(6,5),door4=(6,7)
(define (problem doors-keys-gems-10)
  (:domain doors-keys-gems)
  (:objects door1 door2 door3 door4 - door
            key1 key2 key3 - key
            gem1 gem2 gem3 - gem)
  (:init (locked door1)
         (locked door2)
         (locked door3)
         (locked door4)
         (= (walls)
            (transpose (bit-mat
               (bit-vec 0 1 0 1 1 1 0 0)
               (bit-vec 0 1 0 0 1 1 0 0)
               (bit-vec 0 1 0 0 1 1 0 0)
               (bit-vec 0 1 1 0 1 1 0 0)
               (bit-vec 0 1 1 0 0 0 0 0)
               (bit-vec 0 0 0 0 1 1 1 1)
               (bit-vec 1 1 1 0 0 0 0 0)
               (bit-vec 1 1 1 0 1 1 1 0))))
         (= (xloc door1) 1)
         (= (yloc door1) 3)
         (= (xloc door2) 2)
         (= (yloc door2) 6)
         (= (xloc door3) 6)
         (= (yloc door3) 5)
         (= (xloc door4) 6)
         (= (yloc door4) 7)
         (= (xloc key1) 3)
         (= (yloc key1) 6)
         (= (xloc key2) 8)
         (= (yloc key2) 1)
         (= (xloc key3) 8)
         (= (yloc key3) 2)
         (= (xloc gem1) 1)
         (= (yloc gem1) 1)
         (= (xloc gem2) 3)
         (= (yloc gem2) 1)
         (= (xloc gem3) 8)
         (= (yloc gem3) 8)
         (= (xpos) 4)
         (= (ypos) 8))
  (:goal (has gem1))
)
