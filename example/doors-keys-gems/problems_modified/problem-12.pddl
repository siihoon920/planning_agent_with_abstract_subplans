;; ASCII ;;
; W: wall, D: door, k: key, g: gem, G: goal-gem, s: start, .: empty
; agent at (2,4), keys: key1=(4,1),key2=(2,8),key3=(3,8)
; gems: gem1=(8,8),gem2=(6,1),gem3=(8,1)
; doors: door1=(4,8),door2=(8,5),door3=(8,3)
(define (problem doors-keys-gems-12)
  (:domain doors-keys-gems)
  (:objects door1 door2 door3 - door
            key1 key2 key3 - key
            gem1 gem2 gem3 - gem)
  (:init (locked door1)
         (locked door2)
         (locked door3)
         (= (walls)
            (transpose (bit-mat
               (bit-vec 0 1 1 0 1 0 1 0)
               (bit-vec 0 1 1 0 1 0 1 0)
               (bit-vec 0 1 1 0 1 0 1 0)
               (bit-vec 0 0 0 0 0 0 1 0)
               (bit-vec 0 1 1 1 1 0 1 0)
               (bit-vec 0 0 0 0 0 0 0 0)
               (bit-vec 1 1 1 1 0 1 1 1)
               (bit-vec 1 0 0 0 0 0 0 0))))
         (= (xloc door1) 4)
         (= (yloc door1) 8)
         (= (xloc door2) 8)
         (= (yloc door2) 5)
         (= (xloc door3) 8)
         (= (yloc door3) 3)
         (= (xloc key1) 4)
         (= (yloc key1) 1)
         (= (xloc key2) 2)
         (= (yloc key2) 8)
         (= (xloc key3) 3)
         (= (yloc key3) 8)
         (= (xloc gem1) 8)
         (= (yloc gem1) 8)
         (= (xloc gem2) 6)
         (= (yloc gem2) 1)
         (= (xloc gem3) 8)
         (= (yloc gem3) 1)
         (= (xpos) 2)
         (= (ypos) 4))
  (:goal (has gem3))
)
